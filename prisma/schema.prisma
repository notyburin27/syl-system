// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SENIOR_STAFF
  STAFF
  INSURANCE // ฝ่ายประกัน — เห็นเฉพาะเมนูต่ออายุรถ
}

model AuthUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hashed
  role      Role     @default(STAFF)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents             TransportDocument[]
  jobs                  Job[]
  driverLeaves          DriverLeave[]
  companyHolidays       CompanyHoliday[]
  monthlyEntries        DriverMonthlyEntry[]
  coveragesCreated      VehicleCoverage[]    @relation("CoverageCreatedBy")
  coverageStatusUpdates VehicleCoverage[]    @relation("CoverageStatusUpdatedBy")
  coverageAttachments   CoverageAttachment[] @relation("AttachmentUploadedBy")
  vehicleAttachments    VehicleAttachment[]  @relation("VehicleAttachmentUploadedBy")

  @@index([username])
  @@map("auth_users")
}

model TransportDocument {
  id    String @id @default(cuid())
  title String

  // Form fields (19 fields)
  date                DateTime?
  customerName        String?
  booking             String?
  agent               String?
  shipName            String?
  invoice             String?
  containerSize       String?
  containerNumber     String?
  sealNumber          String?
  shipping            String?
  pickupLocation      String?
  returnLocation      String?
  closingTime         DateTime?
  factoryTime         String?
  loadingSlot         String?
  driverName          String?
  vehicleRegistration String?
  phoneNumber         String?
  remarks             String?

  // Metadata
  createdById String
  createdBy   AuthUser @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@index([createdAt])
  @@map("transport_documents")
}

// ==================== Stock Module ====================

model Product {
  id           String   @id @default(cuid())
  name         String
  sellingPrice Float
  image        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockIns  StockIn[]
  stockOuts StockOut[]

  @@index([name])
  @@map("products")
}

model Buyer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockOuts StockOut[]
  invoices  Invoice[]

  @@index([name])
  @@map("buyers")
}

model StockIn {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  purchasePrice Float
  quantity      Int
  date          DateTime
  note          String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([date])
  @@map("stock_ins")
}

model StockOut {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  buyerId      String
  buyer        Buyer     @relation(fields: [buyerId], references: [id])
  quantity     Int
  sellingPrice Float
  date         DateTime
  isDelivered  Boolean   @default(false)
  deliveredAt  DateTime?
  invoiceId    String?
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id])
  note         String?
  createdAt    DateTime  @default(now())

  @@index([productId])
  @@index([buyerId])
  @@index([invoiceId])
  @@index([date])
  @@map("stock_outs")
}

model Invoice {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       Buyer     @relation(fields: [buyerId], references: [id])
  totalAmount Float
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  stockOuts StockOut[]

  @@index([buyerId])
  @@index([isPaid])
  @@map("invoices")
}

// ==================== Job Management Module ====================

model Customer {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs        Job[]
  incomeRates RateIncome[]

  @@index([name])
  @@map("customers")
}

model Driver {
  id                  String    @id @default(cuid())
  name                String    @unique
  vehicleNumber       String?
  vehicleRegistration String?
  groupName           String?
  baseSalary          Decimal?  @db.Decimal(10, 2)
  startDate           DateTime? @db.Date
  /// รถก๊าซ — หน้าสรุปจะเว้นว่างบล็อกน้ำมันและยอดคงเหลือของบริษัท
  isGasVehicle        Boolean   @default(false)
  isActive            Boolean   @default(true)
  resignedAt          DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bankAccounts   DriverBankAccount[]
  jobs           Job[]
  leaves         DriverLeave[]
  monthlyEntries DriverMonthlyEntry[]

  @@index([name])
  @@index([groupName])
  @@map("drivers")
}

/// ค่าที่กรอกมือในหน้าสรุปงาน แยกตามคนขับ+เดือน (ระบบไม่มีข้อมูลเหล่านี้จากที่อื่น)
model DriverMonthlyEntry {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  /// รูปแบบ 'YYYY-MM' — ใช้เป็นคีย์เดือนเหมือนที่อื่นในระบบสรุปงาน
  month    String

  /// แบก (เที่ยว)
  carryTrips    Int?
  /// หัก น้ำมัน/หยุด (บาท) — ปกติเป็นค่าลบ
  fuelDeduction Decimal? @db.Decimal(10, 2)
  /// ค่าใช้จ่ายต่างๆ (บาท)
  otherExpenses Decimal? @db.Decimal(10, 2)
  /// สรุปให้เงินเดือนคนรถ (บาท)
  driverPayout  Decimal? @db.Decimal(10, 2)

  updatedById String
  updatedBy   AuthUser @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([driverId, month])
  @@index([driverId])
  @@index([month])
  @@map("driver_monthly_entries")
}

model DriverBankAccount {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bankName    String
  accountNo   String
  accountName String
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@map("driver_bank_accounts")
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   @default("general") // "factory" | "general"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupJobs            Job[]            @relation("PickupLocation")
  factoryJobs           Job[]            @relation("FactoryLocation")
  returnJobs            Job[]            @relation("ReturnLocation")
  rateTransfers         RateTransfer[]   @relation("RateTransferLocation")
  rateIncomeFactory     RateIncome[]     @relation("RateIncomeFactory")
  rateDriverWageFactory RateDriverWage[] @relation("RateDriverWageFactory")

  @@index([name])
  @@index([type])
  @@map("locations")
}

model Job {
  id String @id @default(cuid())

  // Core fields
  jobDate    DateTime  @db.Date
  jobType    String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  jobNumber  String    @unique
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id])
  size       String?

  // Location fields
  pickupLocationId  String?
  pickupLocation    Location? @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  factoryLocationId String?
  factoryLocation   Location? @relation("FactoryLocation", fields: [factoryLocationId], references: [id])
  returnLocationId  String?
  returnLocation    Location? @relation("ReturnLocation", fields: [returnLocationId], references: [id])

  // Financial fields
  income             Decimal? @db.Decimal(10, 2)
  driverWage         Decimal? @db.Decimal(10, 2)
  estimatedPickupFee Decimal? @db.Decimal(10, 2)
  estimatedReturnFee Decimal? @db.Decimal(10, 2)
  actualTransferPrev Decimal? @db.Decimal(10, 2)
  advance            Decimal? @db.Decimal(10, 2)
  toll               Decimal? @db.Decimal(10, 2)
  pickupFee          Decimal? @db.Decimal(10, 2)
  returnFee          Decimal? @db.Decimal(10, 2)
  liftFee            Decimal? @db.Decimal(10, 2)
  storageFee         Decimal? @db.Decimal(10, 2)
  tire               Decimal? @db.Decimal(10, 2)
  other              Decimal? @db.Decimal(10, 2)

  // Mileage & Fuel
  mileage          Int?
  fuelOfficeLiters Decimal? @db.Decimal(10, 2)
  fuelCashLiters   Decimal? @db.Decimal(10, 2)
  fuelCashAmount   Decimal? @db.Decimal(10, 2)
  fuelCreditLiters Decimal? @db.Decimal(10, 2)
  fuelCreditAmount Decimal? @db.Decimal(10, 2)

  // Status fields
  clearStatus       Boolean @default(false)
  statementVerified Boolean @default(false)
  isCancelled       Boolean @default(false)
  /// แบก — นับเพิ่มควบคู่กับหมวดเดิมในหน้าสรุป ไม่ได้แทนที่
  isCarry           Boolean @default(false)
  /// ทอยตู้ที่ถูกงานหลัก (รับตู้จากคาหาง/รับเช้าเดินทาง) ดูดซับ
  /// ค่าเที่ยวถูกล้างแล้ว และไม่นับเป็นเที่ยวในหน้าสรุป
  isTowingAbsorbed  Boolean @default(false)

  // Remarks
  remarks String?

  // ไม่มีงาน (jobType = "noJob") — เหตุผลและหมายเหตุ
  noJobReason String?

  // Carry-over relation
  carryOverToJobId String?
  carryOverToJob   Job?    @relation("CarryOver", fields: [carryOverToJobId], references: [id])
  carryOverFromJob Job[]   @relation("CarryOver")

  // Towing link relations
  towingLinksAsMain  JobTowingLink[] @relation("TowingMainJob")
  towingLinkAsTowing JobTowingLink?  @relation("TowingJob")

  // Pair link relations — จับคู่งานที่วิ่งครั้งเดียวแต่แยกใบ
  pairLinkAsPrimary   JobPairLink? @relation("PairPrimary")
  pairLinkAsSecondary JobPairLink? @relation("PairSecondary")

  // Metadata
  createdById String
  createdBy   AuthUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transfers JobTransfer[]

  @@index([carryOverToJobId])
  @@index([jobDate])
  @@index([jobType])
  @@index([customerId])
  @@index([driverId])
  @@index([createdById])
  @@map("jobs")
}

model JobTowingLink {
  id          String   @id @default(cuid())
  mainJobId   String
  mainJob     Job      @relation("TowingMainJob", fields: [mainJobId], references: [id], onDelete: Cascade)
  towingJobId String   @unique
  towingJob   Job      @relation("TowingJob", fields: [towingJobId], references: [id])
  sequence    Int // 1 = รับตู้ (xxx→SYL), 2 = คืนตู้ (SYL→xxx)
  createdAt   DateTime @default(now())

  @@unique([mainJobId, sequence])
  @@index([mainJobId])
  @@map("job_towing_links")
}

/// จับคู่งาน — สองใบที่วิ่งครั้งเดียวกัน ยอดรวมอยู่ที่ใบ primary
/// @unique ทั้งสองฝั่งบังคับว่าหนึ่งใบอยู่ได้แค่คู่เดียว และเป็นได้ฝั่งเดียว
model JobPairLink {
  id             String   @id @default(cuid())
  /// ใบที่ถือยอด — createdAt ใหม่กว่า
  primaryJobId   String   @unique
  primaryJob     Job      @relation("PairPrimary", fields: [primaryJobId], references: [id], onDelete: Cascade)
  /// ใบที่ถูกล้างยอด — income/driverWage = null
  secondaryJobId String   @unique
  secondaryJob   Job      @relation("PairSecondary", fields: [secondaryJobId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@map("job_pair_links")
}

model JobTransfer {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@map("job_transfers")
}

// ==================== Leave & Holiday ====================

model DriverLeave {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  leaveDate   DateTime @db.Date
  leaveType   String // "sick" | "personal" | "other"
  note        String?
  createdById String
  createdBy   AuthUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([driverId, leaveDate])
  @@index([driverId])
  @@index([leaveDate])
  @@map("driver_leaves")
}

model CompanyHoliday {
  id          String   @id @default(cuid())
  holidayDate DateTime @unique @db.Date
  name        String
  createdById String
  createdBy   AuthUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([holidayDate])
  @@map("company_holidays")
}

// ==================== Rate Tables ====================

model RateTransfer {
  id         String   @id @default(cuid())
  jobType    String
  size       String
  locationId String
  pickupFee  Decimal  @db.Decimal(10, 2)
  returnFee  Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation("RateTransferLocation", fields: [locationId], references: [id])

  @@unique([jobType, size, locationId])
  @@map("rate_transfer")
}

model RateIncome {
  id                String   @id @default(cuid())
  jobType           String
  size              String
  factoryLocationId String
  customerId        String
  income            Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  factoryLocation Location                  @relation("RateIncomeFactory", fields: [factoryLocationId], references: [id])
  customer        Customer                  @relation(fields: [customerId], references: [id])
  fuelSurcharges  RateIncomeFuelSurcharge[]

  @@unique([jobType, size, factoryLocationId, customerId])
  @@map("rate_income")
}

// ช่วงราคาน้ำมัน → surcharge เพิ่มจาก income ฐาน (ผูกกับ RateIncome แต่ละ record)
model RateIncomeFuelSurcharge {
  id           String  @id @default(cuid())
  rateIncomeId String
  fuelPriceMin Decimal @db.Decimal(10, 2) // ราคาน้ำมัน >= (บาท/ลิตร)
  fuelPriceMax Decimal @db.Decimal(10, 2) // ราคาน้ำมัน < (บาท/ลิตร)
  surcharge    Decimal @db.Decimal(10, 2) // ค่าเพิ่ม/ลด จากราคาฐาน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateIncome RateIncome @relation(fields: [rateIncomeId], references: [id], onDelete: Cascade)

  @@map("rate_income_fuel_surcharge")
}

// บันทึกราคาน้ำมัน รายวัน
model FuelPriceLog {
  id            String   @id @default(cuid())
  effectiveDate DateTime @db.Date // วันที่มีผล
  pricePerLiter Decimal  @db.Decimal(10, 2) // ราคา บาท/ลิตร
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([effectiveDate])
  @@index([effectiveDate])
  @@map("fuel_price_log")
}

model RateDriverWage {
  id                String   @id @default(cuid())
  jobType           String
  size              String
  factoryLocationId String?
  driverWage        Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  factoryLocation Location? @relation("RateDriverWageFactory", fields: [factoryLocationId], references: [id])

  @@unique([jobType, size, factoryLocationId])
  @@map("rate_driver_wage")
}

// ==================== LINE Bot Module ====================

model LineWebhookLog {
  id        String   @id @default(cuid())
  level     String // "error" | "alert" | "info"
  source    String // "line-webhook" | "watchdog"
  messageId String?
  groupId   String?
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@map("line_webhook_logs")
}

model LineImage {
  id                String   @id @default(cuid())
  imageUrl          String
  senderId          String
  senderDisplayName String
  groupId           String
  groupName         String
  sentAt            DateTime
  messageId         String   @unique
  createdAt         DateTime @default(now())

  @@index([sentAt])
  @@index([senderId])
  @@index([groupId])
  @@map("line_images")
}

// ============================================
// ต่ออายุรถ (พรบ. / ภาษี / ประกัน)
// ============================================

enum VehicleStatus {
  ACTIVE // ใช้งาน
  SUSPENDED // งดใช้ (แจ้ง ม.89)
  SOLD // ขาย / เลิกใช้ (แจ้ง ม.79)
  ADDED // เพิ่ม (รถเพิ่งเพิ่มเข้าระบบ)
  PENDING_REVIEW // รอตรวจสอบ
  OTHER // อื่นๆ
}

enum CoverageType {
  PRB // พรบ.
  TAX // ภาษี
  MOTOR_INSURANCE // ประกันรถยนต์
  CARGO_INSURANCE // ประกันสินค้า (ความรับผิดผู้ขนส่ง)
}

enum RenewalStatus {
  PENDING
  IN_PROGRESS
  RENEWED
  NOT_RENEWED
}

enum NotRenewedReason {
  SOLD
  SUSPENDED
  ACCIDENT
  REPAIR
  OTHER
}

model Vehicle {
  id               String        @id @default(cuid())
  /// normalize แล้ว (lib/renewals/plate.ts)
  plate            String        @unique
  /// จังหวัดของป้ายทะเบียน (ชื่อเต็มตาม lib/renewals/provinces.ts)
  plateProvince    String?
  registrationDate DateTime?     @db.Date
  /// เบอร์รถ — free text ไม่ unique (หัวกับหางใช้เลขซ้ำกันได้)
  fleetNumber      String?
  ownerName        String
  vehicleType      String
  brand            String?
  /// แบบ/รุ่น
  modelName        String?
  color            String?
  /// เลขตัวรถ (คัสซี)
  chassisNumber    String?
  chassisPosition  String?
  engineNumber     String?
  engineCylinders  Int?
  engineHorsepower Int?
  axleCount        Int?
  fuelType         String?
  weightKg         Int?
  status           VehicleStatus @default(ACTIVE)
  statusDate       DateTime?     @db.Date
  /// รถอยู่ไหน — ค่าจาก VEHICLE_LOCATIONS (lib/renewals/constants.ts), null = ไม่ระบุ
  currentLocation  String?
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  coverages       VehicleCoverage[]   @relation("CoverageVehicle")
  pairedCoverages VehicleCoverage[]   @relation("CoveragePairedVehicle")
  attachments     VehicleAttachment[]

  @@index([ownerName])
  @@map("vehicles")
}

model Insurer {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverages VehicleCoverage[]

  @@map("insurers")
}

/// 1 แถว = 1 งวดของรถ 1 คัน 1 ประเภท; สถานะการต่ออยู่บนงวดที่กำลังจะหมด
model VehicleCoverage {
  id              String       @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle      @relation("CoverageVehicle", fields: [vehicleId], references: [id])
  type            CoverageType
  insurerId       String?
  insurer         Insurer?     @relation(fields: [insurerId], references: [id])
  /// ตัวแทนที่ทำประกัน/พรบ. ให้ (free text)
  agentName       String?
  coverageClass   String?
  policyNumber    String?
  startDate       DateTime?    @db.Date
  /// วันสุดท้ายที่คุ้มครอง (inclusive)
  endDate         DateTime     @db.Date
  amount          Decimal?     @db.Decimal(10, 2)
  serviceFee      Decimal?     @db.Decimal(10, 2)
  pairedVehicleId String?
  pairedVehicle   Vehicle?     @relation("CoveragePairedVehicle", fields: [pairedVehicleId], references: [id])

  renewalStatus     RenewalStatus     @default(PENDING)
  notRenewedReason  NotRenewedReason?
  renewalNote       String?
  renewedToId       String?           @unique
  renewedTo         VehicleCoverage?  @relation("CoverageRenewal", fields: [renewedToId], references: [id])
  renewedFrom       VehicleCoverage?  @relation("CoverageRenewal")
  statusUpdatedAt   DateTime?
  statusUpdatedById String?
  statusUpdatedBy   AuthUser?         @relation("CoverageStatusUpdatedBy", fields: [statusUpdatedById], references: [id])
  createdById       String
  createdBy         AuthUser          @relation("CoverageCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  attachments CoverageAttachment[]

  @@unique([vehicleId, type, endDate])
  @@index([renewalStatus, endDate])
  @@index([vehicleId, type])
  @@map("vehicle_coverages")
}

model CoverageAttachment {
  id           String          @id @default(cuid())
  coverageId   String
  coverage     VehicleCoverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedBy   AuthUser        @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([coverageId])
  @@map("coverage_attachments")
}

/// เอกสารสำเนารถ (เล่มทะเบียน ฯลฯ) — ผูกกับรถ ไม่ใช่งวด
model VehicleAttachment {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedBy   AuthUser @relation("VehicleAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([vehicleId])
  @@map("vehicle_attachments")
}
